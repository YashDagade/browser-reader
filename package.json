{
  "name": "hermes-reader",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "A personal, local-first Chrome article reader",
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "demo": "node scripts/demo-server.mjs",
    "package": "node scripts/package.mjs",
    "vendor:pdf": "node scripts/vendor-pdf.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "engines": {
    "node": ">=22"
  }
}
